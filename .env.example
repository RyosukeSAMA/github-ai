# Copy to .env and fill in your API keys. Never commit .env.

# OpenAI (used by Athena, Apollo, and any GPT-based roles)
OPENAI_API_KEY=sk-...

# Anthropic (used by Hermes and Hephaestus by default)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default API endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: enable Ollama for local models
# OLLAMA_BASE_URL=http://localhost:11434
